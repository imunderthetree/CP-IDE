{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cp-ide",
  "version": "1.0.0",
  "identifier": "com.yusuf.cp-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CP-IDE — Competitive Programming",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright \u00a9 2026 Yusuf",
    "shortDescription": "Competitive Programming IDE",
    "longDescription": "A high-performance desktop IDE tailored for competitive programming. Compile locally, analyze complexity natively, and manage test cases.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "CP-IDE"
      }
    }
  }
}
